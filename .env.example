# Copie para .env e ajuste. Todas as variáveis usam o prefixo INVENTARIO_.
INVENTARIO_HOST=0.0.0.0
INVENTARIO_PORT=8443
INVENTARIO_CERT_FILE=certs/cert.pem
INVENTARIO_KEY_FILE=certs/key.pem
INVENTARIO_OUTPUT_DIR=data/keyframes

# Seletor de frames-chave
INVENTARIO_SAMPLE_FPS=5
INVENTARIO_ANALYSIS_WIDTH=640
INVENTARIO_MOTION_THRESHOLD=6.0
INVENTARIO_STABLE_SAMPLES=3
INVENTARIO_SHARPNESS_THRESHOLD=80.0
INVENTARIO_NOVELTY_THRESHOLD=12.0
INVENTARIO_MIN_KEYFRAME_INTERVAL_S=1.0
INVENTARIO_JPEG_QUALITY=92

# Processadores plugáveis (caminhos "modulo:Classe" separados por vírgula)
INVENTARIO_PROCESSORS=inventario_visual.processors:LogProcessor
# Para ativar a detecção (requer: uv sync --extra visao):
# INVENTARIO_PROCESSORS=inventario_visual.processors:LogProcessor,inventario_visual.vision:YoloWorldProcessor

# YOLO-World
INVENTARIO_YOLO_MODEL=yolov8l-worldv2.pt
INVENTARIO_YOLO_MODELS_DIR=models
INVENTARIO_YOLO_CLASSES_FILE=config/classes.txt
INVENTARIO_YOLO_DEVICE=auto
INVENTARIO_YOLO_CONF=0.15
INVENTARIO_YOLO_IOU=0.5
INVENTARIO_YOLO_IMGSZ=640
INVENTARIO_YOLO_HALF=true
INVENTARIO_YOLO_AGNOSTIC_NMS=true
INVENTARIO_YOLO_SAVE_CROPS=true
INVENTARIO_YOLO_SAVE_ANNOTATED=true
